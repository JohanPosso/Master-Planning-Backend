NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Europe/Madrid
# Proxies delante de la API (para leer la IP real al fichar por Wi-Fi). 1 en Railway/Render; true si hay varios.
TRUST_PROXY=1
# Duración de la sesión desde que se entra (luego hay que volver a entrar): 1h, 30m, 8h…
JWT_EXPIRES_IN=1h
JWT_SECRET=dev-secret-cambiar
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# DATABASE_URL=postgres://usuario:clave@host:5432/jornada
# DB_SSL=true

DB_HOST=localhost
DB_PORT=5433
DB_NAME=jornada
DB_USER=jornada
DB_PASSWORD=jornada
DB_LOGGING=false
