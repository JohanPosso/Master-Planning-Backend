NODE_ENV=test
PORT=3000
# Orígenes permitidos (separados por comas)
CORS_ORIGIN=http://localhost:5173
# Zona horaria del negocio: define qué es «hoy» (p. ej. al eliminar una empleada)
APP_TIMEZONE=Europe/Madrid

# Opción A: URL completa (Neon, Supabase, Railway…)
# DATABASE_URL=postgres://usuario:clave@host:5432/jornada
# DB_SSL=true

# Opción B: parámetros sueltos (docker compose local)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jornada_test
DB_USER=jornada
DB_PASSWORD=jornada
DB_LOGGING=false
